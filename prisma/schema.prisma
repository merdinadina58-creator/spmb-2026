// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Registration {
  id                  String   @id @default(cuid())
  noRegistrasi        String
  nama                String
  nisn                String
  subJalur            String
  npsnSekolahPilihan  String
  namaSekolahPilihan  String
  jurusan             String
  npsnSekolahAsal     String
  namaSekolahAsal     String
  status              String   @default("ON PROGRESS")
  waktuDaftar         String
  verificationStatus  String   @default("PENDING") // PENDING, VERIFIED, REJECTED
  verificationNote    String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Portal SPMB additional fields
  nik                 String?
  tanggalLahir        String?
  alamat              String?
  alamatLengkap       String?
  noTelpSiswa         String?
  noTelpOrangtua      String?
  latitude            String?
  longitude           String?
  lokasiJarak         String?
  nilaiRataRata       String?
  skorJarak           String?
  skorNilaiRaport     String?
  skor                String?
  nilaiRapor          String?  // JSON string for subject grades

  // Verification-specific fields
  kekuranganVerifikasi String?  // Missing documents/issues for verification
  tanggalVerif        String?  // Date of verification
  jamVerif            String?  // Time of verification
  terbitKK            String?  // Family card issuance date
  lamaKK              String?  // Duration since KK issued
  dokumen             String?  // JSON string for uploaded documents

  @@unique([noRegistrasi, npsnSekolahPilihan])
  @@unique([nisn, npsnSekolahPilihan])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model JalurConfig {
  id          String   @id @default(cuid())
  nama        String   @unique  // Nama jalur, e.g. "Domisili", "Afirmasi (KTM)"
  persentase  Float    @default(0)  // Persentase kuota
  urutan      Int      @default(0)  // Urutan tampilan
  aktif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
